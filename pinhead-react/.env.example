# Supabase URL
SUPABASE_URL=https://your-project.supabase.co

# Vite-exposed Supabase credentials (used by the frontend app)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key — НЕ публикуйте этот ключ!
# Где взять:
#   1. Откройте Supabase Dashboard → ваш проект
#   2. Settings → API
#   3. Скопируйте "service_role" ключ (НЕ anon/publishable)
SUPABASE_SERVICE_KEY=

# Наблюдаемость (C7 аудита). Пусто — отправка ошибок ВЫКЛЮЧЕНА, приложение
# работает как раньше. Подойдёт любой приёмник POST с JSON: Sentry Store API,
# Logflare, вебхук. Отправляются сообщение, стек, адрес экрана, версия сборки.
#
# Сюда же уходят ОТКАЗЫ SUPABASE (`erpError`, source `erp-supabase`): 42501
# от стража на действии, которое интерфейс разрешил, конфликт версий, оборванный
# запрос. Именно это и приезжает из цеха — белый экран там редкость. Офлайн
# не отправляется: это состояние сети, а не поломка, и слать всё равно некуда.
#
# ⚠️ ЗАДАВ АДРЕС, впишите его хост в `connect-src` заголовка CSP в `vercel.json`.
# Сейчас заголовок идёт как `Content-Security-Policy-Report-Only`, поэтому
# запрос не заблокируется, — но включение боевого режима CSP однажды тихо
# отключит наблюдаемость, и узнать об этом будет уже неоткуда.
VITE_ERROR_REPORT_URL=

# Версия сборки в отчёте об ошибке — чтобы отличать «уже починено» от «ещё нет»
VITE_RELEASE=

# Dev-автологин: подставляет фиктивного администратора ВМЕСТО отсутствующей сессии.
# Пусто/0 — выключен, показывается обычная форма входа. Включайте (=1) только когда
# работаете против мока или пустой базы: на боевой базе он показывает полный доступ
# админа, а запросы уходят ролью anon — чтение возвращает пусто, запись отвечает
# «new row violates row-level security policy». Настоящая сессия всегда важнее:
# если вы вошли, автологин не срабатывает даже при =1.
VITE_DEV_AUTOLOGIN=

# Адрес приложения для подвала ТЗ в PDF (веха 6+7, К9): ссылка на заказ печатается
# этим адресом, а не адресом вкладки — ТЗ, собранное на превью-деплое или localhost,
# не напечатает чужой адрес. Пусто — боевой https://pinhead-os.vercel.app
VITE_APP_ORIGIN=
