dist
node_modules
.env
.env.*
# Окружение прогона e2e — часть репозитория, а не чья-то локальная настройка:
# в нём только два флага (автологин против мока и включённый Order Studio),
# ключей нет. Без него `npm run e2e` у следующего разработчика снова упрётся
# в экран входа всеми 187 сценариями — ровно то, что чинил этот файл.
!pinhead-react/.env.e2e
.playwright-mcp/
skills-lock.json
*.png
!pinhead-react/e2e/**/*.png
!pinhead-react/public/icon-*.png
.DS_Store
test-results/

# Ruflo / claude-flow runtime & data (не версионируется)
.claude-flow/
.swarm/
.agents/
.claude/helpers/*.db
.hive-mind/
memory.db
