flowchart TB
  subgraph ROLES["Роли и видимость"]
    R1["Менеджер продаж — свои"]
    R2["РОП — все, согласует, переназначает"]
    R3["Дизайнер — очередь задач"]
    R4["Технолог — ТЗ пошива/разработки, лекала"]
    R5["Менеджер сопровождения — запуск"]
  end

  subgraph ORDER["ORDER — блок продаж"]
    direction TB
    L["Заказы: канбан / таблица"]
    T["Задачи: одна очередь по времени"]
    E["Экспресс-прикидка"]
    A["Аналитика: воронка · этапы · маржа · экспорт"]
    N["Уведомления: колокол + браузер"]

    subgraph CARD["Карточка заказа (тираж / образец / разработка / переделка)"]
      direction TB
      H["Шапка: цена на лету · срок · сделка · доставка"]
      V["Варианты до 3: набор позиций / внутри позиции"]
      P["Список позиций"]
      PK["Упаковка · складывание · вложения · ЧЗ"]
      PAY["Платежи: предоплата / доплата, остаток"]
      D["КП (PDF + ссылка) · ТЗ · тех-лист · текст"]
      C["Чат сделки — общий с ERP, согласование цены"]
      HI["История"]
    end

    subgraph WIZ["Визард позиции"]
      direction LR
      W1["1 Тип<br/>SKU · бланк · давальческое · разработка"]
      W2["2 Изделие<br/>поиск → карточки, ткань + поставщик"]
      W3["3 Сетка<br/>цвет × размер"]
      W4["4 Нанесения<br/>дизайн-мейкер: цвет × группа размеров<br/>→ Применить к ТЗ"]
      W5["5 Бирки<br/>6 типов, библиотека / конструктор"]
      W1 --> W2 --> W3 --> W4 --> W5
    end
    P --> WIZ
  end

  subgraph LIB["Библиотеки"]
    direction LR
    LE["ERP: SKU + флэты на размер, ткани и поставщики,<br/>бланки, зоны, бирки, упаковка, Pantone, маркировка"]
    LO["Order: конструктор цен нанесений, ставки подготовки,<br/>прайсы образцов/разработки, пороги, сроки, календарь, шаблоны КП"]
  end

  subgraph FLOW["Статусы"]
    direction LR
    S0["draft"] --> S1["quoted"]
    S0 -. ниже порога .-> SR["price_review<br/>РОП в чате"]
    SR --> S1
    S1 --> S2["paid + tz_ready<br/>(+ технолог)"]
    S2 --> S3["ready_to_launch"]
    S3 --> S4["production"]
    S4 --> S5["done = на складе ГП"]
    S4 -. запрос отмены .-> SX["cancelled"]
    S0 -. закрыть .-> SA["archived"]
  end

  subgraph ERP["ERP"]
    X["Производственный заказ"]
    Y["Экономика: цена продажи"]
    Z["Склад ГП → done · чат"]
    EX["ЭКС: образец, разработка → новая модель в каталог"]
  end

  ROLES --> ORDER
  LIB --> WIZ
  CARD --> FLOW
  S3 -->|мост| X
  X --> Y
  X --> Z
  Z --> H
  EX -. образец утверждён → тираж .-> P
